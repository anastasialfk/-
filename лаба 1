# ---------- 4. Диаграмма по sequence.txt ----------
file = open('sequence.txt', 'r')
numbers = []
for number in file:
    numbers.append(float(number))
file.close()

inside = 0                        # числа от -3 до 3
for n in numbers:
    if -3 <= n <= 3:
        inside += 1
outside = len(numbers) - inside   # остальные

percent_in = inside / len(numbers) * 100
percent_out = 100 - percent_in    # вместе ровно 100%

length = 50
n_in = round(length * percent_in / 100)
print(f'{GREEN}{" " * n_in}{RED}{" " * (length - n_in)}{END}')
print(f'{GREEN}  {END} от -3 до 3: {inside} шт. ({percent_in:.1f}%)')
print(f'{RED}  {END} остальные: {outside} шт. ({percent_out:.1f}%)')