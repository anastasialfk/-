# ---------- 3. Анимация: график y = x / 3 (4 кадра) ----------
limits = [-6, -1, 4, 9]          # до какого x нарисован график в каждом кадре

os.system(CLEAR)                 # очищаем консоль перед анимацией
print(HIDE, end='')              # прячем курсор, чтобы не мигал

for limit in limits:
    print(f'y = x / 3, рисуем до x = {limit}\n')
    for y in range(3, -4, -1):
        line = f'{y}\t'
        for x in range(-9, 10):
            if x <= limit and abs(x / 3 - y) < 0.5:
                line += '!!!'
            else:
                line += '---'
        print(line)
    line = '\t'
    for x in range(-9, 10):
        line += f'{x:<3}'        # подпись шириной 3 символа, как и клетка
    print(line)
    time.sleep(1)
    if limit != limits[-1]:
        print(UP10 + CLEAR_DOWN, end='')   # вернуться наверх и стереть кадр

print(SHOW, end='')              # возвращаем курсор

